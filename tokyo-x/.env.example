# ============================================================
# TOKYO-X environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- OpenRouter (multi-provider fallback) ----------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ---------- ElevenLabs (voice / TTS) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ---------- TOKYO-X core ----------
TOKYOX_HOST=127.0.0.1
TOKYOX_PORT=8787
TOKYOX_WORKSPACE_ROOT=./workspace
TOKYOX_AUDIT_DIR=./logs/audit
TOKYOX_LOG_LEVEL=info

# Secret used to sign approval tokens (CONFIRM actions).
# Generate a long random string; required before Phase 4 goes live.
TOKYOX_APPROVAL_TOKEN_SECRET=change-me-long-random-string
